---
import Layout from "../layouts/Layout.astro";
import { sql, type Offer } from "../lib/db";

// Otwarte ogłoszenia, najnowsze na górze.
const offers = await sql<Offer[]>`SELECT * FROM offers WHERE status = 'open' ORDER BY created_at DESC`;
---

<Layout>
  <div class="mb-4 flex items-center justify-between">
    <h1 class="text-2xl font-bold">Ogłoszenia</h1>
    <a href="/new" class="btn btn-primary btn-sm">Dodaj ogłoszenie</a>
  </div>

  {offers.length === 0 && <div class="alert">Nie ma jeszcze ogłoszeń. Dodaj pierwsze!</div>}

  <div class="flex flex-col gap-3">
    {
      offers.map((offer) => (
        <div class="card bg-base-100 shadow transition hover:shadow-md">
          <div class="card-body">
            <div class="flex items-start justify-between gap-2">
              <h2 class="card-title">{offer.title}</h2>
              <span class="badge badge-primary whitespace-nowrap">{offer.budget_sol} SOL</span>
            </div>
            <p class="line-clamp-2 opacity-70">{offer.description}</p>
            <p class="text-xs opacity-50">{offer.created_at.toLocaleDateString("pl-PL")}</p>
            <div class="card-actions justify-end">
              <a href={`/o/${offer.id}`} class="btn btn-sm">Zobacz ogłoszenie</a>
              <a href={`/o/${offer.id}#chat`} data-chat-author={offer.client_wallet} class="btn btn-primary btn-sm">Otwórz chat</a>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</Layout>

<script>
  import { onWalletChange, type ConnectedWallet } from "../lib/wallet";
  const chatButtons = [...document.querySelectorAll<HTMLAnchorElement>("[data-chat-author]")];
  onWalletChange((wallet: ConnectedWallet | null) => {
    chatButtons.forEach((button) => {
      const own = wallet?.address === button.dataset.chatAuthor;
      button.classList.toggle("btn-disabled", Boolean(own));
      button.setAttribute("aria-disabled", String(own));
      if (own) button.textContent = "To Twoje ogłoszenie";
    });
  });
  chatButtons.forEach((button) => button.addEventListener("click", (event) => {
    if (button.getAttribute("aria-disabled") === "true") event.preventDefault();
  }));
</script>
