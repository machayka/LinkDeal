---
import ContactIcon from "../../components/ContactIcon.astro";
import Layout from "../../layouts/Layout.astro";
import { sql, type Offer } from "../../lib/db";

const id = Number(Astro.params.id);
const [offer] = Number.isInteger(id) ? await sql<Offer[]>`SELECT * FROM offers WHERE id = ${id}` : [];
if (!offer) Astro.response.status = 404;

// „Utwórz ofertę” otwiera aplikację umów z kwotą z ogłoszenia.
const contractUrl = offer && `${import.meta.env.PUBLIC_APP_URL}/new?amount=${offer.budget_sol}`;
const budget = offer && Number(offer.budget_sol).toLocaleString("pl-PL", { maximumFractionDigits: 9 });
---

<Layout title={offer?.title ?? "Nie znaleziono"}>
  <a href="/" class="link link-hover mb-3 inline-block text-sm opacity-70">← Wszystkie ogłoszenia</a>

  {!offer && <div class="alert">Nie ma takiego ogłoszenia.</div>}
  {
    offer && (
      <div class="card bg-base-100 shadow">
        <div class="card-body gap-4">
          <div>
            <h1 class="text-2xl font-bold">{offer.title}</h1>
            <p class="text-xs opacity-60">Dodane {offer.created_at.toLocaleDateString("pl-PL")}</p>
          </div>
          <p>
            Budżet: <span class="text-lg font-semibold">{budget} SOL</span>{" "}
            <span class="text-sm opacity-60">(orientacyjny)</span>
          </p>
          {offer.status === "closed" && <div class="alert alert-warning">Ogłoszenie zamknięte.</div>}
          <p class="whitespace-pre-line">{offer.description}</p>

          {/* Dla wykonawców — ukrywane, gdy ogląda autor (skrypt poniżej). */}
          {offer.status === "open" && (
            <div id="for-others" class="flex flex-wrap items-center justify-between gap-2">
              <p class="text-sm opacity-70">Chcesz się podjąć tego zlecenia? Przygotuj ofertę dla zleceniodawcy.</p>
              <div class="flex gap-2">
                {/* „Napisz”: kanały kontaktu autora, pobierane dopiero po połączeniu portfela (skrypt poniżej). */}
                <div class="dropdown dropdown-end">
                  <div tabindex="0" role="button" class="btn">Napisz</div>
                  <ul tabindex="0" class="dropdown-content menu bg-base-100 rounded-box z-10 w-72 p-2 shadow">
                    <li id="contact-wallet"><span class="text-sm">Połącz portfel, aby zobaczyć kontakt.</span></li>
                    <li id="contact-telegram" class="hidden"><a target="_blank"><ContactIcon kind="telegram" /><span /></a></li>
                    <li id="contact-email" class="hidden"><a><ContactIcon kind="email" /><span /></a></li>
                    <li id="contact-discord" class="hidden"><button type="button"><ContactIcon kind="discord" /><span /></button></li>
                  </ul>
                </div>
                <a href={contractUrl} class="btn btn-primary">Utwórz ofertę</a>
              </div>
            </div>
          )}
          <div id="for-author" class="alert hidden">
            <span>To Twoje ogłoszenie. Zarządzasz nim w <a href="/my" class="link">Moich ogłoszeniach</a>.</span>
          </div>
        </div>
      </div>
    )
  }
</Layout>

{offer && <span id="author" data-address={offer.client_wallet} data-id={offer.id} data-title={offer.title} hidden />}

<script>
  import { onWalletChange } from "../../lib/wallet";

  // Autor ogłoszenia nie składa oferty sam sobie — widzi link do zarządzania ogłoszeniem.
  const { address: author, id, title } = document.querySelector<HTMLElement>("#author")?.dataset ?? {};
  const item = (name: string) => document.querySelector<HTMLElement>(`#contact-${name}`)!;
  let contactLoaded = false;

  onWalletChange((wallet) => {
    const isAuthor = !!wallet && wallet.address === author;
    document.querySelector("#for-others")?.classList.toggle("hidden", isAuthor);
    document.querySelector("#for-author")?.classList.toggle("hidden", !isAuthor);
    if (wallet && !isAuthor) loadContact();
  });

  // Kontakt autora: Telegram otwiera rozmowę, e-mail program pocztowy, Discord kopiuje nick (nie ma linku do rozmowy).
  async function loadContact() {
    if (contactLoaded || !id) return;
    const response = await fetch(`/api/offers/${id}/contact`);
    if (!response.ok) return;
    const contact: { email: string | null; telegram: string | null; discord: string | null } = await response.json();
    contactLoaded = true;
    // Starsze ogłoszenia mogą nie mieć kontaktu.
    if (!contact.telegram && !contact.email && !contact.discord) {
      item("wallet").querySelector("span")!.textContent = "Autor nie podał kontaktu.";
      return;
    }
    item("wallet").classList.add("hidden");
    const show = (name: string, text: string) => {
      item(name).classList.remove("hidden");
      item(name).querySelector("span")!.textContent = text; // dane od autora — zawsze jako tekst
      return item(name).querySelector<HTMLAnchorElement & HTMLButtonElement>("a, button")!;
    };
    if (contact.telegram) show("telegram", `Telegram · @${contact.telegram}`).href = `https://t.me/${contact.telegram}`;
    if (contact.email)
      show("email", `E-mail · ${contact.email}`).href =
        `mailto:${contact.email}?subject=${encodeURIComponent(`Ogłoszenie: ${title}`)}`;
    if (contact.discord) {
      const button = show("discord", `Discord · ${contact.discord} (kopiuj)`);
      button.onclick = () => {
        navigator.clipboard.writeText(contact.discord!);
        button.querySelector("span")!.textContent = `Skopiowano „${contact.discord}” — wyszukaj na Discordzie`;
      };
    }
  }
</script>
