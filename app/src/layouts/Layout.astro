---
import "../styles/global.css";
import { BOARD_URL, EXPLORER_PROGRAM_URL, GITHUB_URL, PRESENTATION_URL } from "../lib/config";

const { title, wide = false } = Astro.props; // wide: szersza kolumna (strona główna)
---

<html lang="pl" data-theme="pokwitowanie">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title ? `${title} · LinkDeal` : "LinkDeal"}</title>
  </head>
  <body class="flex min-h-screen flex-col bg-base-200">
    <nav class="navbar border-b border-base-300 bg-base-100">
      <div class="flex-1">
        <a href="/" class="btn btn-ghost font-display px-2 text-xl font-extrabold tracking-tight sm:text-2xl">LinkDeal</a>
        <a href="/o-projekcie" class="btn btn-ghost btn-sm hidden sm:inline-flex">O projekcie</a>
        <a href="/dla-kogo" class="btn btn-ghost btn-sm hidden sm:inline-flex">Dla kogo</a>
        <a href={BOARD_URL} target="_blank" class="btn btn-ghost btn-sm hidden sm:inline-flex">Ogłoszenia ↗</a>
      </div>
      <div class="flex items-center gap-1">
        <a href="/me" class="btn btn-ghost btn-sm">Moje umowy</a>
        <button id="wallet-button" class="btn btn-primary btn-sm">Połącz portfel</button>
      </div>
    </nav>

    <main class:list={["mx-auto w-full flex-1 p-4", wide ? "max-w-5xl" : "max-w-2xl"]}>
      <slot />
    </main>

    <footer class="border-t border-base-300 bg-base-100">
      <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-4 px-4 py-6 text-sm">
        <p class="opacity-70">LinkDeal: escrow dla freelancerów na Solanie. HackYeah Hackathon.</p>
        <nav class="flex flex-wrap gap-x-5 gap-y-2">
          <a href="/o-projekcie" class="link link-hover">O projekcie</a>
          <a href="/dla-kogo" class="link link-hover">Dla kogo</a>
          <a href={BOARD_URL} target="_blank" class="link link-hover">Ogłoszenia ↗</a>
          <a href={PRESENTATION_URL} target="_blank" class="link link-hover">Prezentacja (PDF)</a>
          <a href={GITHUB_URL} target="_blank" class="link link-hover">Kod na GitHubie</a>
          <a href={EXPLORER_PROGRAM_URL} target="_blank" class="link link-hover">Program w Solana Explorer</a>
        </nav>
      </div>
    </footer>

    <!-- Okienko portfela: lista portfeli albo (po połączeniu) adres i „Rozłącz” -->
    <dialog id="wallet-modal" class="modal">
      <div class="modal-box max-w-sm">
        <h3 id="wallet-title" class="mb-4 text-lg font-bold"></h3>
        <ul id="wallet-list" class="menu w-full gap-1 p-0"></ul>
      </div>
      <form method="dialog" class="modal-backdrop"><button>zamknij</button></form>
    </dialog>

    <script>
      import {
        availableWallets,
        connect,
        disconnect,
        onWalletChange,
        onWalletsRegistered,
        reconnect,
        shortAddress,
        type AnchorWallet,
      } from "../lib/wallet";

      const button = document.querySelector<HTMLButtonElement>("#wallet-button")!;
      const modal = document.querySelector<HTMLDialogElement>("#wallet-modal")!;
      const list = document.querySelector<HTMLElement>("#wallet-list")!;
      const title = document.querySelector<HTMLElement>("#wallet-title")!;
      let current: AnchorWallet | null = null;

      // Wypełnia okienko zależnie od stanu: niepołączony → portfele, połączony → adres i „Rozłącz”.
      function renderModal() {
        list.innerHTML = "";
        title.textContent = current ? "Twój portfel" : "Połącz portfel";
        if (current) {
          list.innerHTML = `
            <li class="mb-2 font-mono text-sm break-all">${current.publicKey.toBase58()}</li>
            <li><button class="btn btn-outline btn-error">Rozłącz</button></li>`;
          list.querySelector("button")!.onclick = () => {
            disconnect();
            modal.close();
          };
          return;
        }
        const wallets = availableWallets();
        if (wallets.length === 0) {
          list.innerHTML = `<li class="text-sm">Nie wykryto portfela. Zainstaluj np. <a href="https://phantom.com/download" target="_blank" class="link inline p-0">Phantom</a> i odśwież stronę.</li>`;
          return;
        }
        for (const wallet of wallets) {
          const item = document.createElement("li");
          item.innerHTML = `<a class="text-base"><img src="${wallet.icon}" class="size-7" /> ${wallet.name}</a>`;
          item.onclick = () => {
            modal.close();
            connect(wallet).catch((e) => console.error(e));
          };
          list.append(item);
        }
      }

      button.onclick = () => {
        renderModal();
        modal.showModal();
      };

      onWalletChange((wallet) => {
        current = wallet;
        button.textContent = wallet ? shortAddress(wallet.publicKey.toBase58()) : "Połącz portfel";
      });

      // Portfele rejestrują się asynchronicznie — próbujemy wtedy wznowić połączenie.
      onWalletsRegistered(reconnect);
      reconnect();
    </script>
  </body>
</html>
