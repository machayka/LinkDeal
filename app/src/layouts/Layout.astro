---
import "../styles/global.css";

const { title } = Astro.props;
const boardUrl = import.meta.env.PUBLIC_BOARD_URL ?? "http://localhost:4322";
---

<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title ? `${title} · LinkDeal` : "LinkDeal"}</title>
  </head>
  <body class="min-h-screen bg-base-200">
    <nav class="navbar bg-base-100 shadow-sm">
      <div class="flex-1">
        <a href="/" class="btn btn-ghost text-xl">LinkDeal</a>
        <a href={boardUrl} class="btn btn-ghost btn-sm">Ogłoszenia</a>
        <a href={`${boardUrl}/new`} class="btn btn-ghost btn-sm">Dodaj ogłoszenie</a>
        <a href={`${boardUrl}/my`} class="btn btn-ghost btn-sm">Moje ogłoszenia</a>
        <a href="/new" class="btn btn-ghost btn-sm">Nowa umowa</a>
      </div>
      <button id="wallet-button" class="btn btn-primary btn-sm">Połącz portfel</button>
      <button id="chat-toggle" class="btn btn-secondary btn-sm">💬 Chat</button>
    </nav>

    <main class="mx-auto max-w-2xl p-4">
      <slot />
    </main>

    <!-- Okienko portfela: lista portfeli albo (po połączeniu) adres i „Rozłącz” -->
    <dialog id="wallet-modal" class="modal">
      <div class="modal-box max-w-sm">
        <h3 id="wallet-title" class="mb-4 text-lg font-bold"></h3>
        <ul id="wallet-list" class="menu w-full gap-1 p-0"></ul>
      </div>
      <form method="dialog" class="modal-backdrop"><button>zamknij</button></form>
    </dialog>

    <aside id="chat-drawer" class="fixed right-0 top-0 z-50 flex h-full w-full max-w-md hidden flex-col bg-base-100 shadow-2xl">
      <div class="flex items-center justify-between border-b border-base-300 p-4">
        <div><h2 class="font-bold">Chat</h2><span id="chat-status" class="badge badge-warning">Łączenie…</span></div>
        <button id="chat-close" class="btn btn-ghost btn-sm">✕</button>
      </div>
      <div class="grid min-h-0 flex-1 grid-cols-[9rem_1fr]">
        <nav class="overflow-y-auto border-r border-base-300 p-2">
          <p class="mb-2 text-xs font-semibold uppercase opacity-60">Rozmowy</p>
          <div id="chat-rooms" class="flex flex-col gap-1"></div>
        </nav>
        <div id="chat-messages" class="flex flex-col gap-2 overflow-y-auto p-4"></div>
      </div>
      <div class="border-t border-base-300 px-3 py-2">
        <p id="chat-room-title" class="truncate text-sm font-semibold">Wybierz rozmowę</p>
      </div>
      <form id="chat-form" class="border-t border-base-300 p-3">
        <textarea id="chat-input" class="textarea textarea-bordered w-full" rows="2" placeholder="Połącz portfel, aby pisać…" disabled></textarea>
        <div class="mt-2 flex items-center gap-2">
          <label class="btn btn-outline btn-sm"><span id="chat-file-label">📎</span><input id="chat-file" type="file" class="hidden" disabled /></label>
          <button class="btn btn-primary btn-sm ml-auto" type="submit">Wyślij</button>
        </div>
        <p id="chat-hint" class="mt-2 text-xs opacity-60">Wiadomości są zapisywane w bazie.</p>
      </form>
    </aside>

    <script>
      import {
        availableWallets,
        connect,
        disconnect,
        onWalletChange,
        onWalletsRegistered,
        reconnect,
        shortAddress,
        type AnchorWallet,
      } from "../lib/wallet";
      import { initChatDrawer } from "../lib/chat-drawer";

      const button = document.querySelector<HTMLButtonElement>("#wallet-button")!;
      const modal = document.querySelector<HTMLDialogElement>("#wallet-modal")!;
      const list = document.querySelector<HTMLElement>("#wallet-list")!;
      const title = document.querySelector<HTMLElement>("#wallet-title")!;
      let current: AnchorWallet | null = null;

      // Wypełnia okienko zależnie od stanu: niepołączony → portfele, połączony → adres i „Rozłącz”.
      function renderModal() {
        list.innerHTML = "";
        title.textContent = current ? "Twój portfel" : "Połącz portfel";
        if (current) {
          list.innerHTML = `
            <li class="mb-2 font-mono text-sm break-all">${current.publicKey.toBase58()}</li>
            <li><button class="btn btn-outline btn-error">Rozłącz</button></li>`;
          list.querySelector("button")!.onclick = () => {
            disconnect();
            modal.close();
          };
          return;
        }
        const wallets = availableWallets();
        if (wallets.length === 0) {
          list.innerHTML = `<li class="text-sm">Nie wykryto portfela. Zainstaluj np. Phantom.</li>`;
          return;
        }
        for (const wallet of wallets) {
          const item = document.createElement("li");
          item.innerHTML = `<a class="text-base"><img src="${wallet.icon}" class="size-7" /> ${wallet.name}</a>`;
          item.onclick = () => {
            modal.close();
            connect(wallet).catch((e) => console.error(e));
          };
          list.append(item);
        }
      }

      button.onclick = () => {
        renderModal();
        modal.showModal();
      };

      onWalletChange((wallet) => {
        current = wallet;
        button.textContent = wallet ? shortAddress(wallet.publicKey.toBase58()) : "Połącz portfel";
      });

      // Portfele rejestrują się asynchronicznie — próbujemy wtedy wznowić połączenie.
      onWalletsRegistered(reconnect);
      reconnect();
      initChatDrawer(onWalletChange);
    </script>
  </body>
</html>
