---
// Ikona ⓘ z dymkiem wyjaśnienia (dropdown z daisyUI — działa też po stuknięciu na telefonie).
const { text } = Astro.props;
---

<span class="dropdown dropdown-hover dropdown-top align-middle">
  <span tabindex="0" role="button" class="btn btn-circle btn-ghost btn-xs" aria-label="Wyjaśnienie">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="size-4 stroke-current">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
    </svg>
  </span>
  <span tabindex="0" class="dropdown-content card card-sm bg-base-200 z-10 w-64 shadow-sm">
    <span class="card-body text-sm font-normal">{text}</span>
  </span>
</span>
