---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Moje umowy">
  <div id="content" class="flex flex-col gap-6">
    <div class="alert">Połącz portfel, aby zobaczyć swoje umowy.</div>
  </div>
</Layout>

<script>
  import { contractStatus, dateTime, explorerAddress, myContracts, sol } from "../lib/program";
  import { onWalletChange } from "../lib/wallet";

  const content = document.querySelector<HTMLElement>("#content")!;

  type Item = Awaited<ReturnType<typeof myContracts>>[number] & { role?: string };

  // Jedna sekcja: nagłówek + karty (albo informacja, że nie ma).
  function section(title: string, contracts: Item[], empty: string) {
    const box = document.createElement("section");
    box.innerHTML = `<h2 class="mb-2 text-lg font-semibold">${title}</h2><div class="flex flex-col gap-2"></div>`;
    const list = box.querySelector("div")!;
    if (contracts.length === 0) list.innerHTML = `<p class="text-sm opacity-60">${empty}</p>`;
    contracts
      .sort((a, b) => a.account.deadline.toNumber() - b.account.deadline.toNumber())
      .forEach(({ publicKey, account, role }) => {
        const [status, statusClass] = contractStatus(account);
        const card = document.createElement("a");
        card.href = `/contract/${publicKey.toBase58()}`;
        card.className = "card bg-base-100 shadow transition hover:shadow-md";
        const more = account.tasks.length - 1;
        card.innerHTML = `<div class="card-body flex-row items-center justify-between gap-2 py-4">
          <div class="min-w-0">
            <div class="truncate font-semibold"><span class="title"></span>${more ? ` <span class="font-normal opacity-60">+ ${more} więcej</span>` : ""}</div>
            <div class="text-xs opacity-60">${sol(account.amount)} · milestone'y ${account.approved}/${account.tasks.length} · deadline ${dateTime(account.deadline)}</div>
          </div>
          <div class="flex flex-col items-end gap-1">
            <span class="badge ${statusClass}">${status}</span>
            ${role ? `<span class="badge badge-ghost badge-sm">${role}</span>` : ""}
          </div>
        </div>`;
        card.querySelector(".title")!.textContent = account.tasks[0].description; // tekst od wykonawcy — jako tekst
        list.append(card);
      });
    return box;
  }

  onWalletChange(async (wallet) => {
    if (!wallet) {
      content.innerHTML = `<div class="alert">Połącz portfel, aby zobaczyć swoje umowy.</div>`;
      return;
    }
    content.innerHTML = `<div class="flex justify-center p-10"><span class="loading loading-spinner loading-lg"></span></div>`;
    const [asFreelancer, asClient] = await Promise.all([
      myContracts(wallet.publicKey, "freelancer"),
      myContracts(wallet.publicKey, "client"),
    ]);

    const history = document.createElement("p");
    history.className = "text-sm opacity-70";
    history.innerHTML = `<a class="link" target="_blank" href="${explorerAddress(wallet.publicKey.toBase58())}">Zakończone umowy znajdziesz w historii portfela w Solana Explorer →</a>`;

    // Oferta = utworzona przeze mnie, jeszcze nieprzyjęta. Umowa = przyjęta (jestem wykonawcą albo zleceniodawcą).
    const offers = asFreelancer.filter(({ account }) => !account.client);
    const contracts = [
      ...asFreelancer.filter(({ account }) => account.client).map((item) => ({ ...item, role: "wykonawca" })),
      ...asClient.map((item) => ({ ...item, role: "zleceniodawca" })),
    ];

    content.replaceChildren(
      section("Moje oferty", offers, "Brak aktywnych ofert. <a href='/new' class='link'>Utwórz ofertę</a>"),
      section("Moje umowy", contracts, "Brak aktywnych umów."),
      history,
    );
  });
</script>
