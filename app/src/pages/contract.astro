---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Umowa">
  <div id="loading" class="flex justify-center p-10"><span class="loading loading-spinner loading-lg"></span></div>

  <div id="missing" class="alert hidden">
    <span>Umowa zakończona albo nie istnieje. <a id="history" target="_blank" class="link">Historia w Solana Explorer</a></span>
  </div>

  <div id="contract" class="flex hidden flex-col gap-4">
    <div class="card bg-base-100 shadow">
      <div class="card-body">
        <div class="flex items-start justify-between gap-2">
          <div>
            <h1 id="kind" class="text-sm opacity-60"></h1>
            <p id="amount" class="font-display text-4xl font-bold"></p>
          </div>
          <span id="status" class="badge badge-lg"></span>
        </div>
        <p id="role" class="font-semibold"></p>
        <p id="rent" class="hidden text-xs opacity-60">
          Twoja kaucja za konto umowy (ok. 0,0065 SOL) wróci do Ciebie po zakończeniu umowy.
        </p>
        <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
          <dt class="opacity-60">Wykonawca</dt><dd id="freelancer"></dd>
          <dt class="opacity-60">Zleceniodawca</dt><dd id="client"></dd>
          <dt class="opacity-60">Oferta ważna do</dt><dd id="offer"></dd>
          <dt class="opacity-60">Deadline</dt><dd id="deadline"></dd>
        </dl>
      </div>
    </div>

    <!-- Milestone'y jako bilet: perforacja między etapami, pieczątka przy zaliczonych -->
    <div class="card bg-base-100">
      <h2 class="card-title px-6 pt-5 pb-4">Milestone'y</h2>
      <div id="tasks"></div>
    </div>

    <!-- Wykonawca: link do wysłania zleceniodawcy (dopóki oferta nie jest przyjęta) -->
    <div id="share" class="card bg-base-100 hidden shadow">
      <div class="card-body gap-2">
        <p>Wyślij ten link zleceniodawcy:</p>
        <div class="join w-full">
          <input id="link" readonly class="input join-item w-full font-mono text-sm" />
          <button id="copy" class="btn join-item">Kopiuj</button>
        </div>
      </div>
    </div>

    <!-- Zleceniodawca: co oznacza przyjęcie oferty -->
    <div id="explain" class="alert alert-info hidden">
      <span>
        Po przyjęciu oferty kwota zostanie zamrożona na koncie umowy. Wykonawca dostanie wynagrodzenie dopiero, gdy zaliczysz
        kolejne milestone'y. To, czego nie zaliczysz do deadline'u, wróci do Ciebie.
      </span>
    </div>

    <div id="actions" class="flex flex-col gap-3"></div>
    <div id="message" class="alert hidden"></div>
  </div>
</Layout>

<script>
  import { web3 } from "@anchor-lang/core";
  import { contractStatus, dateTime, errorMessage, explorerAddress, explorerTx, fetchEscrow, getProgram, sol, type Escrow } from "../lib/program";
  import { BOARD_URL } from "../lib/config";
  import { onWalletChange, shortAddress, type AnchorWallet } from "../lib/wallet";

  const $ = <T extends HTMLElement>(selector: string) => document.querySelector<T>(selector)!;
  const addressText = location.pathname.split("/")[2] ?? "";

  let wallet: AnchorWallet | null = null;
  let escrow: Escrow | null = null;
  let busy = false;

  // Adres z linku → konto umowy z blockchaina.
  async function load() {
    let address: web3.PublicKey;
    try {
      address = new web3.PublicKey(addressText);
    } catch {
      return showMissing();
    }
    escrow = await fetchEscrow(address);
    $("#loading").classList.add("hidden");
    if (!escrow) return showMissing();
    $("#contract").classList.remove("hidden");
    render();
  }

  function showMissing() {
    $("#loading").classList.add("hidden");
    $("#contract").classList.add("hidden");
    $<HTMLAnchorElement>("#history").href = explorerAddress(addressText);
    $("#missing").classList.remove("hidden");
  }

  const addressLink = (key: web3.PublicKey | null) => {
    if (!key) return document.createTextNode("— oferta jeszcze nie została przyjęta");
    const link = document.createElement("a");
    link.href = explorerAddress(key.toBase58());
    link.target = "_blank";
    link.className = "link font-mono";
    link.textContent = shortAddress(key.toBase58());
    return link;
  };

  function render() {
    if (!escrow) return;
    const now = Date.now() / 1000;
    const funded = escrow.client !== null;
    const offerValid = now < escrow.offerExpiresAt.toNumber();
    const beforeDeadline = now < escrow.deadline.toNumber();
    const me = wallet?.publicKey;
    const isFreelancer = !!me && me.equals(escrow.freelancer);
    const isClient = !!me && !!escrow.client && me.equals(escrow.client);

    // Nagłówek
    const [statusText, statusClass] = contractStatus(escrow, now);
    $("#status").textContent = statusText;
    $("#status").className = `badge badge-lg ${statusClass}`;
    $("#kind").textContent = funded ? "Umowa" : "Oferta";
    $("#amount").textContent = sol(escrow.amount);
    $("#share").classList.toggle("hidden", !(isFreelancer && !funded && offerValid));
    $("#explain").classList.toggle("hidden", !(!isFreelancer && !funded && offerValid));
    $("#role").textContent = isFreelancer ? "Jesteś wykonawcą" : isClient ? "Jesteś zleceniodawcą" : "";
    $("#rent").classList.toggle("hidden", !isFreelancer);
    $("#freelancer").replaceChildren(addressLink(escrow.freelancer));
    $("#client").replaceChildren(addressLink(escrow.client));
    $("#offer").textContent = dateTime(escrow.offerExpiresAt);
    $("#deadline").textContent = dateTime(escrow.deadline);

    // Milestone'y: opis (tekst od wykonawcy — zawsze przez textContent), kwota i stan.
    $("#tasks").replaceChildren(
      ...escrow.tasks.map((task, index) => {
        const row = document.createElement("div");
        row.className = "ticket-row flex items-center gap-4 px-6 py-4";
        const done = index < escrow!.approved;
        const next = index === escrow!.approved && funded && beforeDeadline;
        const state = done
          ? `<span class="stamp">zaliczony</span>`
          : next
            ? `<span class="badge badge-primary badge-outline">następny</span>`
            : `<span class="text-sm opacity-50">oczekuje</span>`;
        row.innerHTML = `<span class="font-display w-4 text-lg font-bold opacity-30">${index + 1}</span>
          <div class="min-w-0 flex-1"><p class="description font-medium break-words"></p><p class="text-sm opacity-60">${sol(task.amount)}</p></div>
          ${state}`;
        row.querySelector(".description")!.textContent = task.description;
        return row;
      }),
    );

    // Przyciski: tylko te akcje, które program w tej chwili przyjmie.
    // hint — tekst pod przyciskiem, note — dopisek w komunikacie po udanej transakcji.
    type Action = { label: string; run: () => Promise<string>; hint?: string; note?: string };
    const actions: Action[] = [];
    const program = wallet && getProgram(wallet);
    const accounts = { escrow: escrowAddress(), freelancer: escrow.freelancer };
    if (program && !funded && offerValid && !isFreelancer)
      actions.push({
        label: `Przyjmij ofertę i zamroź ${sol(escrow.amount)}`,
        run: () => program.methods.fund().accountsPartial({ ...accounts, client: me! }).rpc(),
        note: `Zlecenie ma wykonawcę — <a class="link" href="${BOARD_URL}/my" target="_blank">możesz już zamknąć swoje ogłoszenie →</a>`,
      });
    if (program && isClient && beforeDeadline) {
      const task = escrow.tasks[escrow.approved];
      actions.push({
        label: `Zalicz milestone ${escrow.approved + 1}: ${task.description}`,
        run: () => program.methods.approveMilestone().accountsPartial({ ...accounts, client: me! }).rpc(),
        hint: `Wykonawca od razu dostanie ${sol(task.amount)}. Tego nie da się cofnąć. Do deadline'u: ${timeLeft(escrow.deadline.toNumber() - now)}.`,
      });
    }
    if (program && !funded && !offerValid)
      actions.push({
        label: isFreelancer ? "Anuluj ofertę i odzyskaj kaucję" : "Anuluj ofertę",
        run: () => program.methods.cancel().accountsPartial(accounts).rpc(),
      });
    if (program && funded && !beforeDeadline)
      actions.push({
        label: "Zwróć niewypłaconą kwotę zleceniodawcy",
        run: () => program.methods.refundAfterDeadline().accountsPartial({ ...accounts, client: escrow!.client! }).rpc(),
      });

    $("#actions").replaceChildren(
      ...actions.map(({ label, run, hint, note }) => {
        const box = document.createElement("div");
        const button = document.createElement("button");
        button.className = "btn btn-primary h-auto min-h-12 w-full py-3 whitespace-normal";
        button.textContent = label; // opis milestone'u od wykonawcy — zawsze jako tekst
        button.disabled = busy;
        button.onclick = () => execute(button, run, note);
        box.append(button);
        if (hint) {
          const text = document.createElement("p");
          text.className = "mt-1 text-xs opacity-60";
          text.textContent = hint;
          box.append(text);
        }
        return box;
      }),
    );
    if (!wallet && (offerValid || funded)) $("#actions").innerHTML = `<p class="text-sm opacity-60">Połącz portfel, aby wykonać akcję.</p>`;
  }

  const escrowAddress = () => new web3.PublicKey(addressText);

  // „3 dni”, „5 godz.”, „12 min” — ile zostało czasu.
  function timeLeft(seconds: number) {
    if (seconds >= 86400) return `${Math.floor(seconds / 86400)} dni`;
    if (seconds >= 3600) return `${Math.floor(seconds / 3600)} godz.`;
    return `${Math.max(1, Math.floor(seconds / 60))} min`;
  }

  // Wysyła transakcję, pokazuje wynik i odświeża dane umowy.
  async function execute(button: HTMLButtonElement, run: () => Promise<string>, note = "") {
    busy = true;
    $("#actions").querySelectorAll("button").forEach((other) => (other.disabled = true));
    button.innerHTML = `<span class="loading loading-spinner"></span> Podpisz w portfelu…`;
    const message = $("#message");
    try {
      const signature = await run();
      message.className = "alert alert-success";
      message.innerHTML = `<span>Gotowe ✓ <a target="_blank" class="link" href="${explorerTx(signature)}">Transakcja w Solana Explorer</a> ${note}</span>`;
    } catch (e) {
      message.className = "alert alert-error";
      message.textContent = errorMessage(e);
    }
    busy = false;
    await load();
  }

  onWalletChange((w) => {
    wallet = w;
    render();
  });

  $<HTMLInputElement>("#link").value = location.origin + location.pathname;
  $("#copy").onclick = () => {
    navigator.clipboard.writeText($<HTMLInputElement>("#link").value);
    $("#copy").textContent = "Skopiowano ✓";
  };
  setInterval(render, 15_000); // status i przyciski zmieniają się z upływem czasu (oferta, deadline)
  load();
</script>
