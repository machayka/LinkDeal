---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Nowa oferta">
  <h1 class="text-2xl font-bold">Twoja oferta dla zleceniodawcy</h1>
  <p class="mb-4 opacity-70">
    Podziel zlecenie na etapy. Za każdy zaliczony milestone od razu dostajesz wynagrodzenie, więc nie ryzykujesz całej
    kwoty. Jeśli współpraca się urwie, zachowujesz to, co już zarobiłeś, a zleceniodawca odzyskuje resztę.
  </p>

  <!-- Walidacja: wbudowana w przeglądarkę (required, min, setCustomValidity) + klasa `validator` z daisyUI,
       która podświetla pole i pokazuje podpowiedź dopiero po próbie wysłania. -->
  <form id="form" class="card bg-base-100 shadow">
    <div class="card-body gap-4">
      <div class="grid gap-4 sm:grid-cols-2">
        <fieldset class="fieldset">
          <legend class="fieldset-legend">Oferta ważna do</legend>
          <input name="offerExpiresAt" type="datetime-local" required class="input validator w-full" />
          <p class="validator-hint hidden">Oferta musi być ważna w przyszłości.</p>
        </fieldset>
        <fieldset class="fieldset">
          <legend class="fieldset-legend">Deadline zlecenia</legend>
          <input name="deadline" type="datetime-local" required class="input validator w-full" />
          <p class="validator-hint hidden">Deadline nie może być wcześniej niż koniec ważności oferty.</p>
        </fieldset>
      </div>

      <div>
        <div class="font-semibold">Milestone'y</div>
        <p class="mb-2 text-sm opacity-60">Zleceniodawca zalicza je po kolei.</p>
        <div id="tasks" class="flex flex-col gap-2"></div>
        <div class="mt-2 flex items-center justify-between">
          <button type="button" id="add-task" class="btn btn-ghost btn-sm">+ Dodaj milestone</button>
          <span id="total" class="text-sm opacity-70"></span>
        </div>
      </div>

      <div id="error" class="alert alert-error hidden"></div>
      <button id="submit" class="btn btn-primary">Wyślij ofertę</button>
      <p class="text-xs opacity-60">
        Utworzenie oferty wymaga kaucji ok. 0,0065 SOL za miejsce na blockchainie. Kaucja wróci do Ciebie w całości, gdy
        umowa się zakończy albo oferta zostanie anulowana.
      </p>
    </div>
  </form>

  <!-- Po utworzeniu oferty: link do wysłania zleceniodawcy -->
  <div id="result" class="card bg-base-100 hidden shadow">
    <div class="card-body">
      <h2 class="card-title">Oferta utworzona ✓</h2>
      <p>Wyślij ten link zleceniodawcy:</p>
      <div class="join w-full">
        <input id="link" readonly class="input join-item w-full font-mono text-sm" />
        <button id="copy" class="btn join-item">Kopiuj</button>
      </div>
      <a id="tx" target="_blank" class="link text-sm">Transakcja w Solana Explorer</a>
    </div>
  </div>

  <template id="task-row">
    <div class="flex flex-wrap items-start gap-2 sm:flex-nowrap">
      <span class="number w-5 pt-2.5 text-sm opacity-60"></span>
      <div class="min-w-0 flex-1">
        <input name="description" required placeholder="np. Projekt logo" class="input validator w-full" />
        <p class="validator-hint hidden">Opisz milestone (maks. 100 znaków, polskie litery liczą się podwójnie).</p>
      </div>
      <div>
        <label class="input validator w-36">
          <input name="amount" type="number" required min="0.000000001" step="any" placeholder="0,1" />
          <span class="opacity-60">SOL</span>
        </label>
        <p class="validator-hint hidden">Podaj kwotę.</p>
      </div>
      <button type="button" class="btn btn-ghost btn-square" title="Usuń">✕</button>
    </div>
  </template>
</Layout>

<script>
  import { BN } from "@anchor-lang/core";
  import { errorMessage, escrowPda, explorerTx, getProgram, randomNonce, sol } from "../lib/program";
  import { onWalletChange, type AnchorWallet } from "../lib/wallet";

  const MAX_TASKS = 10;
  const MAX_DESCRIPTION_BYTES = 100;
  const form = document.querySelector<HTMLFormElement>("#form")!;
  const tasks = document.querySelector<HTMLElement>("#tasks")!;
  const total = document.querySelector<HTMLElement>("#total")!;
  const addTask = document.querySelector<HTMLButtonElement>("#add-task")!;
  const submit = document.querySelector<HTMLButtonElement>("#submit")!;
  const error = document.querySelector<HTMLElement>("#error")!;
  const rowTemplate = document.querySelector<HTMLTemplateElement>("#task-row")!;
  const offerInput = form.elements.namedItem("offerExpiresAt") as HTMLInputElement;
  const deadlineInput = form.elements.namedItem("deadline") as HTMLInputElement;

  let wallet: AnchorWallet | null = null;

  function addTaskRow(amount = "") {
    const row = rowTemplate.content.firstElementChild!.cloneNode(true) as HTMLElement;
    row.querySelector<HTMLInputElement>("[name=amount]")!.value = amount;
    row.querySelector("button")!.onclick = () => {
      row.remove();
      update();
    };
    tasks.append(row);
    update();
  }

  // Milestone'y z formularza: opis i kwota w lamportach (1 SOL = 10^9 lamportów).
  function readTasks() {
    return [...tasks.children].map((row) => ({
      description: row.querySelector<HTMLInputElement>("[name=description]")!.value.trim(),
      amount: new BN(Math.round(Number(row.querySelector<HTMLInputElement>("[name=amount]")!.value) * 1e9)),
    }));
  }

  // Po każdej zmianie: numery, suma, przyciski oraz reguły, których przeglądarka nie zna sama
  // (daty względem siebie, limit opisu w bajtach — tak liczy program).
  function update() {
    const rows = [...tasks.children];
    rows.forEach((row, i) => {
      row.querySelector(".number")!.textContent = `${i + 1}.`;
      row.querySelector<HTMLButtonElement>("button")!.disabled = rows.length === 1;
      const description = row.querySelector<HTMLInputElement>("[name=description]")!;
      const tooLong = new TextEncoder().encode(description.value.trim()).length > MAX_DESCRIPTION_BYTES;
      description.setCustomValidity(tooLong ? "Za długi opis." : "");
    });
    addTask.disabled = rows.length >= MAX_TASKS;

    const amount = readTasks().reduce((sum, task) => sum.add(task.amount), new BN(0));
    total.textContent = amount.isZero() ? "" : `Kwota zlecenia: ${sol(amount)}`;

    const offer = new Date(offerInput.value).getTime();
    offerInput.setCustomValidity(offer > Date.now() ? "" : "Oferta musi być ważna w przyszłości.");
    deadlineInput.setCustomValidity(new Date(deadlineInput.value).getTime() >= offer ? "" : "Za wczesny deadline.");

    submit.disabled = !wallet;
    submit.textContent = wallet ? "Wyślij ofertę" : "Połącz portfel, aby wysłać ofertę";
  }

  form.oninput = update;
  addTask.onclick = () => addTaskRow();
  onWalletChange((w) => {
    wallet = w;
    update();
  });

  // Wywoływane tylko, gdy formularz jest poprawny — inaczej przeglądarka wskazuje błędne pola.
  form.onsubmit = async (event) => {
    event.preventDefault();
    if (!wallet) return;
    const toUnix = (input: HTMLInputElement) => new BN(Math.floor(new Date(input.value).getTime() / 1000));
    const nonce = randomNonce();

    submit.disabled = true;
    submit.innerHTML = `<span class="loading loading-spinner"></span> Podpisz w portfelu…`;
    error.classList.add("hidden");
    try {
      const signature = await getProgram(wallet)
        .methods.createEscrow(nonce, readTasks(), toUnix(deadlineInput), toUnix(offerInput))
        .accounts({ freelancer: wallet.publicKey })
        .rpc();

      const pda = escrowPda(wallet.publicKey, nonce).toBase58();
      document.querySelector<HTMLInputElement>("#link")!.value = `${location.origin}/contract/${pda}`;
      document.querySelector<HTMLAnchorElement>("#tx")!.href = explorerTx(signature);
      form.classList.add("hidden");
      document.querySelector("#result")!.classList.remove("hidden");
    } catch (e) {
      error.textContent = errorMessage(e);
      error.classList.remove("hidden");
      update();
    }
  };

  document.querySelector<HTMLButtonElement>("#copy")!.onclick = (event) => {
    navigator.clipboard.writeText(document.querySelector<HTMLInputElement>("#link")!.value);
    (event.currentTarget as HTMLButtonElement).textContent = "Skopiowano ✓";
  };

  // Na start jeden milestone; kwota z linku z ogłoszenia (ogloszenia.linkdeal.fun → „Utwórz ofertę”).
  addTaskRow(new URLSearchParams(location.search).get("amount") ?? "");
</script>
